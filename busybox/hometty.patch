 /* Do TAB completion */
+/* Optional hometty completion provider: argv transport, never shell evaluation.
+ * Child timeout bounds an unavailable launcher; normal file completion remains the fallback. */
+static void hometty_complete(const char *line)
+{
+    const char *helper = getenv("HOMETTY_COMPLETER");
+    int fds[2], status;
+    pid_t pid;
+    FILE *fp;
+    char *candidate;
+    unsigned count = 0;
+    if (!helper || helper[0] != '/' || pipe(fds) != 0)
+        return;
+    pid = fork();
+    if (pid == 0) {
+        close(fds[0]);
+        dup2(fds[1], STDOUT_FILENO);
+        close(fds[1]);
+        close(STDIN_FILENO);
+        close(STDERR_FILENO);
+        signal(SIGALRM, SIG_DFL);
+        alarm(2);
+        execl(helper, "hometty", "__complete", line, (char *)NULL);
+        _exit(127);
+    }
+    close(fds[1]);
+    if (pid < 0) { close(fds[0]); return; }
+    fp = fdopen(fds[0], "r");
+    if (fp) {
+        while ((candidate = xmalloc_fgetline(fp)) != NULL) {
+            if (candidate[0] && strlen(candidate) < MAX_LINELEN && count++ < 200)
+                add_match(candidate);
+            else
+                free(candidate);
+        }
+        fclose(fp);
+    } else close(fds[0]);
+    while (waitpid(pid, &status, 0) < 0 && errno == EINTR) {}
+}
